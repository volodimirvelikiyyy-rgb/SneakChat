# Leave empty to use the safe deterministic conversational fallback.
AI_PROVIDER=disabled

# Optional Groq understanding layer; never put a real key in this example or Git.
# On Windows use Set-SneakChatGroqKey.ps1 for per-user encrypted storage.
GROQ_API_KEY=

# Set AI_PROVIDER=ollama and model name only after Ollama and a local model are installed.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=60
AI_DEBUG=false
